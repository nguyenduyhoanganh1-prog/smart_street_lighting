# Defaults for Freenove ESP32-S3 WROOM N8R8 (8 MB flash, 8 MB octal PSRAM: boot log shows N8R8).
# Run `idf.py set-target esp32s3` first. If your module is NOT N8R8, change or
# remove the flash/PSRAM lines, otherwise the board may fail to boot.

# Flash: 3 MB app partition (WiFi + TLS + MQTT + camera + FOMO model), see partitions.csv
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM (frame buffers, MQTT image buffer)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 240 MHz: FOMO inference (the 160 MHz default is too slow for 3-5 inferences per second)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 1 ms tick so short delays (sensor timing) are accurate
CONFIG_FREERTOS_HZ=1000

# The camera driver task runs on core 1; WiFi + MQTT stay on core 0
CONFIG_CAMERA_CORE1=y

# The FOMO arena (~307 KB) is bigger than this threshold, so it goes to PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Optimise the inference kernels for speed
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# app_main runs the init, including the first (warm-up) FOMO inference in detector_init(): 4 KB overflows.
# The tasks it creates have their own stacks (control 8 KB, network 8 KB, vision 16 KB).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# TLS to HiveMQ Cloud: verify the server with the built-in CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
