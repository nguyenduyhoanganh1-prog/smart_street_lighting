# Board actually detected: ESP32-S3 with 8 MB flash + 8 MB octal PSRAM (N8R8).
# 8 MB is also safe on an N16R8 module (it just uses the first half of the flash).
# Declaring MORE flash than the chip has makes the app abort at boot:
#   "Detected size(8192k) smaller than the size in the binary image header".
# Run `idf.py set-target esp32s3` first.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 240 MHz: the camera driver copies every grayscale frame byte by byte (see APP_CAM_XCLK_HZ)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Camera copy task on core 1: WiFi (prio 23) and the HTTP server live on core 0. Sharing core 0
# starved the copy as soon as a browser connected ("cam_hal: FB-SIZE: 0 != 307200").
CONFIG_CAMERA_CORE1=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# SD card: file names like "nguoi.0007.rgb565" and "phien_001" need long file names (LFN)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# HTTP server: a few routes plus a polled JPEG preview. 3 sockets are reserved internally,
# so 7 open sockets leave room for 4 clients; LWIP must offer enough sockets for that.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128
CONFIG_LWIP_MAX_SOCKETS=10
