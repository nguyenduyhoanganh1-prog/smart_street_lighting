# Same module as streetlight-wifi: Freenove ESP32-S3 WROOM N16R8 (16 MB flash, 8 MB octal PSRAM).
# Run `idf.py set-target esp32s3` first. If your module is NOT N16R8, change or
# remove the flash/PSRAM lines, otherwise the board may fail to boot.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# SD card: file names like "nguoi.0007.rgb565" and "phien_001" need long file names (LFN)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# HTTP server: a few routes plus a polled JPEG preview. 3 sockets are reserved internally,
# so 7 open sockets leave room for 4 clients; LWIP must offer enough sockets for that.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128
CONFIG_LWIP_MAX_SOCKETS=10
