# Same hardware profile as thu_dataset (Freenove ESP32-S3-WROOM CAM, 8 MB flash, octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_CAMERA_CORE1=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128
CONFIG_LWIP_MAX_SOCKETS=10

# The TFLite arena (~307 KB) is larger than this threshold, so it goes to PSRAM. Raise the
# threshold above the arena size to try it in internal SRAM (faster, but leaves less for WiFi).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Optimise the inference kernels for speed
CONFIG_COMPILER_OPTIMIZATION_PERF=y
